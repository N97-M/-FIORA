# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-never-share-publicly"

# Prisma Database Connections
# Vercel/serverless runtime must use the pooled Supabase connection for DATABASE_URL.
# Use the "Transaction pooler" string from Supabase Dashboard > Connect.
# The host must be aws-...pooler.supabase.com, not db.<project-ref>.supabase.co.
# Add pgbouncer=true because Supavisor transaction mode does not support prepared statements.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations/admin scripts should use a non-transaction connection.
# Prefer direct DB if your machine/CI has IPv6 or Supabase IPv4 add-on.
# From IPv4-only environments, use Supabase's "Session pooler" string instead:
# postgresql://postgres.<project-ref>:<password>@aws-...pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"
