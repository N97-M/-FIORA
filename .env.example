# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-never-share-publicly"

# Prisma Database Connections
# Vercel/serverless runtime must use the pooled Supabase connection for DATABASE_URL.
# Use the "Transaction pooler" string from Supabase, usually:
# postgresql://postgres.<project-ref>:<password>@aws-...pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection is for migrations/admin scripts only, not Vercel runtime.
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"
