generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = "file:./dev.db"
}

// 1. Admin Users
model User {
  id          String   @id @default(uuid())
  email       String   @unique @default("admin@fiora.com")
  username    String   @unique
  displayName String   @default("Admin")
  password    String
  role        String   @default("EDITOR") // SUPERADMIN, EDITOR, GALLERY_MANAGER
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 2. Hero Section
model Hero {
  id             Int      @id @default(1)
  title_en       String   @default("FIORA | Luxury Event Decor")
  title_ar       String   @default("فيورة | لتنسيق المناسبات")
  tagline_en     String   @default("LUXURY STARTS HERE")
  tagline_ar     String   @default("الفخامة تبدأ من هنا")
  btn_gallery_en String   @default("View Gallery")
  btn_gallery_ar String   @default("مشاهدة المعرض")
  btn_contact_en String   @default("Contact Us")
  btn_contact_ar String   @default("تواصل معنا")
  
  // Hero Features
  feat_1_en      String   @default("Rental")
  feat_1_ar      String   @default("تأجير")
  feat_2_en      String   @default("Design")
  feat_2_ar      String   @default("تصميم")
  feat_3_en      String   @default("Delivery")
  feat_3_ar      String   @default("توصيل")

  // Background Media
  bg_type          String   @default("IMAGE") // Desktop: IMAGE or VIDEO
  image_url        String   @default("/hero-bg.jpg")
  mobile_bg_type   String   @default("IMAGE") // Mobile: IMAGE or VIDEO
  mobile_image_url String   @default("")
  overlay_opacity  Float   @default(0.5)
  updatedAt        DateTime @updatedAt
}

// 3. Navbar Settings
model Navbar {
  id                Int      @id @default(1)
  logo_url          String   @default("/logo.png")
  favicon_url       String   @default("/favicon.ico")
  
  // Navigation Links
  nav_home_en       String   @default("Home")
  nav_home_ar       String   @default("الرئيسية")
  nav_about_en      String   @default("About Us")
  nav_about_ar      String   @default("من نحن")
  nav_services_en   String   @default("Services")
  nav_services_ar   String   @default("خدماتنا")
  nav_gallery_en    String   @default("Gallery")
  nav_gallery_ar    String   @default("أعمالنا")
  nav_how_en        String   @default("How We Work")
  nav_how_ar        String   @default("كيف نعمل")
  nav_contact_en    String   @default("Contact")
  nav_contact_ar    String   @default("اتصل بنا")
  nav_testimonials_en String @default("Testimonials")
  nav_testimonials_ar String @default("آراء العملاء")

  sticky_enabled    Boolean  @default(true)
  lang_switch_show  Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

// 4. About Section
model About {
  id           Int      @id @default(1)
  title_en     String   @default("About FIORA")
  title_ar     String   @default("عن فيورة")
  content_en   String   @default("FIORA is a luxury event decor rental brand...")
  content_ar   String   @default("فيورة هي علامة تجارية فاخرة لتأجير ديكورات المناسبات...")
  image_url    String   @default("/about-img.jpg")
  values       Value[]
  updatedAt    DateTime @updatedAt
}

model Value {
  id        String @id @default(uuid())
  text_en   String
  text_ar   String
  aboutId   Int
  about     About  @relation(fields: [aboutId], references: [id])
}

// 5. Services
model Service {
  id          String   @id @default(uuid())
  title_en    String
  title_ar    String
  desc_en     String
  desc_ar     String
  icon        String   @default("fas fa-star")
  image_url   String?
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// 6. Gallery Categories
model Category {
  id        String    @id @default(uuid())
  name_en   String
  name_ar   String
  order     Int       @default(0)
  items     GalleryItem[]
}

// 7. Gallery Items
model GalleryItem {
  id          String   @id @default(uuid())
  title_en    String
  title_ar    String
  desc_en     String
  desc_ar     String
  image_url   String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  isFeatured  Boolean  @default(false)
  isVisible   Boolean  @default(true)
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// 8. Booking & Socials
model Settings {
  id               Int      @id @default(1)
  whatsapp_number  String   @default("249123456789")
  whatsapp_msg_en  String   @default("Hello FIORA, I would like to inquire about...")
  whatsapp_msg_ar  String   @default("مرحباً فيورة، أود الاستفسار عن...")
  phone_number     String   @default("249123456789")
  tiktok_url       String   @default("#")
  instagram_url    String   @default("#")
  snapchat_url     String   @default("#")
  status           String   @default("AVAILABLE") // AVAILABLE, BUSY, CLOSED
  services_center_image String?
  updatedAt        DateTime @updatedAt
}

// 9. Theme Settings
model Theme {
  id               Int      @id @default(1)
  
  // Website
  bg_website       String   @default("#ffffff")
  text_primary     String   @default("#000000")
  text_secondary   String   @default("#555555")
  accent_gold      String   @default("#DBC07E")

  // Header
  bg_header        String   @default("transparent")
  text_header      String   @default("#000000")
  text_header_mobile String @default("#000000")
  text_header_hover String  @default("#DBC07E")

  // Footer
  bg_footer        String   @default("#0a0a0a")
  text_footer      String   @default("#ffffff")
  link_footer      String   @default("rgba(255,255,255,0.7)")
  accent_footer    String   @default("#DBC07E")

  // Cards
  bg_card          String   @default("#FDFBF7")
  text_card        String   @default("#000000")

  // Badges & Categories
  bg_badge         String   @default("#222222")
  text_badge       String   @default("#DBC07E")

  // Buttons
  bg_button        String   @default("#000000")
  text_button      String   @default("#ffffff")

  // Legacy/Other
  primary_gold     String   @default("#DBC07E")
  bg_dark          String   @default("#0a0a0a")
  text_white       String   @default("#ffffff")
  background_color String   @default("#ffffff")
  text_color       String   @default("#000000")
  border_radius    String   @default("15px")
  glass_opacity    Float    @default(0.1)

  updatedAt        DateTime @updatedAt
}

// 10. SEO
model SEO {
  id               Int      @id @default(1)
  meta_title_en    String   @default("FIORA | Luxury Event Decor")
  meta_title_ar    String   @default("فيورة | لتنسيق المناسبات")
  meta_desc_en     String   @default("Luxury event decor rentals in Sudan.")
  meta_desc_ar     String   @default("تأجير ديكورات المناسبات الفاخرة في السودان.")
  og_image         String?
  keywords         String   @default("luxury, event, decor, sudan, fiora")
  updatedAt        DateTime @updatedAt
}

// 11. Before & After
model BeforeAfter {
  id           String   @id @default(uuid())
  title_en     String
  title_ar     String
  desc_en      String
  desc_ar      String
  before_image String
  after_image  String
  order        Int      @default(0)
  isVisible    Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

// 12. Process Steps (How We Work)
model ProcessStep {
  id          String   @id @default(uuid())
  step_number Int
  title_en    String
  title_ar    String
  desc_en     String
  desc_ar     String
  isVisible   Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// 13. Testimonials
model Testimonial {
  id             String   @id @default(uuid())
  client_name_en String
  client_name_ar String
  content_en     String
  content_ar     String
  rating         Int      @default(5)
  isVisible      Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

// 14. Footer Settings
model Footer {
  id               Int      @id @default(1)
  logo_url         String   @default("/logo.png")
  description_en   String   @default("A creative studio designing elegant spaces and event experiences.")
  description_ar   String   @default("استوديو إبداعي لتصميم المساحات الأنيقة وتنسيق المناسبات.")
  copyright_en     String   @default("All rights reserved.")
  copyright_ar     String   @default("جميع الحقوق محفوظة.")
  slogan_en        String   @default("LUXURY STARTS HERE")
  slogan_ar        String   @default("الفخامة تبدأ من هنا")
  
  // Contact overrides for footer (optional, can fallback to Settings)
  address_en       String   @default("Khartoum, Sudan")
  address_ar       String   @default("الخرطوم، السودان")
  email            String   @default("info@fiora.com")
  
  // Quick Links
  link1_en         String   @default("Interior Design")
  link1_ar         String   @default("تصميم داخلي")
  link2_en         String   @default("Event Styling")
  link2_ar         String   @default("تنسيق المناسبات")
  link3_en         String   @default("Space Planning")
  link3_ar         String   @default("تخطيط المساحات")

  updatedAt        DateTime @updatedAt
}
